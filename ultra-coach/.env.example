# PostgreSQL
DATABASE_URL="postgresql://coach:coach@localhost:5432/ultracoach"
# URL publique de l'appli (sans / final) — sert au retour OAuth Strava
APP_URL="http://localhost:3000"

# Clé API Claude (https://console.anthropic.com) — nécessaire pour le coach IA
ANTHROPIC_API_KEY=""

# Chiffrement des tokens en base : chaîne aléatoire ≥ 32 caractères
# (génère-la avec : openssl rand -base64 32)
TOKEN_ENC_KEY=""

# Strava (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# Jeton libre choisi par toi, utilisé pour valider l'abonnement webhook
STRAVA_VERIFY_TOKEN=""
